generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum OrganizationStatus {
  ACTIVE
  DEACTIVATED
}

enum CourseStatus {
  ACTIVE
  DEACTIVATED
}

model User {
  id                 Int               @id @default(autoincrement())
  organizationId     Int?              @map("organization_id")
  name               String
  displayName        String
  email              String            @unique
  password           String
  phone              String
  userType           UserType
  status             UserStatus        @default(ACTIVE)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  organization       Organization?     @relation("OrganizationMembers", fields: [organizationId], references: [id])
  ownedOrganizations Organization[]    @relation("OrganizationOwner")
  bookmarks          Bookmark[]
  completedCourses   CompletedCourse[]

  @@index([organizationId])
  @@map("users")
}

model Organization {
  id         Int                  @id @default(autoincrement())
  employeeId Int                  @map("employee_id")
  name       String
  status     OrganizationStatus   @default(ACTIVE)
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")
  owner      User                 @relation("OrganizationOwner", fields: [employeeId], references: [id])
  users      User[]               @relation("OrganizationMembers")
  courses    OrganizationCourse[]

  @@map("organizations")
}

model Course {
  id               Int                  @id @default(autoincrement())
  name             String
  summary          String
  content          Json
  status           CourseStatus         @default(ACTIVE)
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  organizations    OrganizationCourse[]
  bookmarks        Bookmark[]
  completedByUsers CompletedCourse[]

  @@map("courses")
}

model OrganizationCourse {
  organizationId Int          @map("organization_id")
  courseId       Int          @map("course_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  course         Course       @relation(fields: [courseId], references: [id])

  @@id([organizationId, courseId])
  @@map("organization_courses")
}

model Bookmark {
  userId    Int      @map("user_id")
  courseId  Int      @map("course_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])

  @@id([userId, courseId])
  @@map("bookmarks")
}

model CompletedCourse {
  userId      Int      @map("user_id")
  courseId    Int      @map("course_id")
  completedAt DateTime @default(now()) @map("completed_at")
  user        User     @relation(fields: [userId], references: [id])
  course      Course   @relation(fields: [courseId], references: [id])

  @@id([userId, courseId])
  @@map("completed_courses")
}
